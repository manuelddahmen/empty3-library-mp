package one.empty3.apps.testobject;

import com.google.cloud.storage.BlobId;
import com.google.cloud.storage.BlobInfo;
import com.google.cloud.storage.Storage;
import com.google.cloud.storage.StorageOptions;
import one.empty3.libs.Image;

import java.io.File;
import java.io.IOException;
import java.nio.file.Files;
import java.util.logging.Level;
import java.util.logging.Logger;

public abstract class CloudStorageTestObjet extends TestObjet {
    private String bucketName;
    private Storage storage;

    public CloudStorageTestObjet() {
        super();
        this.storage = StorageOptions.getDefaultInstance().getService();
        this.bucketName = System.getenv("GCS_BUCKET_NAME");
    }

    public void setBucketName(String bucketName) {
        this.bucketName = bucketName;
    }

    @Override
    protected void afterRenderFrame() {
        super.afterRenderFrame();
        if (bucketName != null && !bucketName.isEmpty()) {
            saveToCloudStorage();
        }
    }

    private void saveToCloudStorage() {
        try {
            // Get the last written file from TestObjet logic
            // TestObjet.run() saves the image to 'subDir/filename.png'
            File localFile = new File(subDir, getFilenameWoExt() + ".png");
            
            if (localFile.exists()) {
                String blobName = getInitialDate() + "/" + getClass().getCanonicalName() + "/" + localFile.getName();
                BlobId blobId = BlobId.of(bucketName, blobName);
                BlobInfo blobInfo = BlobInfo.newBuilder(blobId).setContentType("image/png").build();
                
                storage.create(blobInfo, Files.readAllBytes(localFile.toPath()));
                Logger.getAnonymousLogger().log(Level.INFO, "Uploaded to GCS: gs://" + bucketName + "/" + blobName);
            }
        } catch (IOException e) {
            Logger.getAnonymousLogger().log(Level.SEVERE, "Failed to upload to GCS", e);
        }
    }
}
